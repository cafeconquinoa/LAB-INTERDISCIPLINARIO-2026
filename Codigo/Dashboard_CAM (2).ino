  if(v.length){tx=Math.max.apply(null,v.map(function(n){return n.temp;}));hmn=Math.min.apply(null,v.map(function(n){return n.hum;}));}
  var et=tx===null?"off":tx>=U.tCrit?"crit":tx>=U.tAdv?"adv":"normal",
