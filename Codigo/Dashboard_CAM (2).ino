  $("zFit").addEventListener("click",function(){zi=0;foco={x:.5,y:.5};encuadrar(true);});
  /* Esc cierra el detalle y devuelve el foco al elemento del nodo */
  document.addEventListener("keydown",function(e){
    if(e.key!=="Escape"){return;}
