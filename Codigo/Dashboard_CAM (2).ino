<style>
/* Inter (SIL OFL) embebida: el ESP32 no tiene internet */
@font-face{font-family:"Inter";font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Inter";font-style:normal;font-weight:500;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Inter";font-style:normal;font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
/* Tokens (auditoría UX/UI, nov 2026): tipografía 12·14·16·20·24·32 · espaciado 4·8·12·16·24·32 · radios 6·10·16 · íconos 16·20·24 con trazo 1,75
   Estructura tipo red social: barra superior con la usuaria · accesos a la izquierda · feed al centro · nodo seleccionado y lista de nodos a la derecha */
:root{
  /* Design System Community: Grey, Primary, Green/Success, Yellow/Warning, Red/Danger, Blue/Info.
     Para los estados se usan los tonos 700 y 800, que cumplen contraste sobre blanco */
  --g900:#131927;--g800:#212936;--g700:#394050;--g600:#4D5461;--g500:#6D717F;--g400:#9EA2AE;--g300:#D2D5DB;--g200:#E5E7EA;--g100:#F3F4F6;--g50:#F9FAFB;
  --p900:#003F6B;--p700:#006AB5;--p600:#0088E8;--p500:#0095FF;--p300:#54B8FF;--p100:#B0DEFF;--p50:#E6F4FF;
  --bg:var(--g100);--panel:#fff;--ink:var(--g900);--muted:var(--g600);--line:var(--g200);--soft:var(--g50);--sel:var(--p50);--trend:var(--g600);--bar:var(--g400);--glifo:var(--g900);
  --ok:#308242;--ok-bg:#ECF8EF;--ok-ink:#256533;
  --warn:#B57900;--warn-bg:#FFF7E6;--warn-ink:#8C5E00;
  --crit:#D93E39;--crit-bg:#FDECEC;--crit-ink:#A9302D;
  --off:#6D717F;--off-bg:var(--g100);--off-ink:var(--g600);
  --info:var(--p500);--info-bg:var(--p50);--info-ink:var(--p700);
  /* tipografía del DS: H5 24 · S1 18 · S2 16 · B3 14 · C1 12 */
  --f12:12px;--f14:14px;--f16:16px;--f20:18px;--f24:24px;--f32:32px;
  --s1:4px;--s2:8px;--s3:12px;--s4:16px;--s5:24px;--s6:32px;
  --r1:6px;--r2:8px;--r3:12px;
  --sh1:0 1px 2px rgba(19,25,39,.06),0 1px 3px rgba(19,25,39,.08);
  --sh2:0 4px 6px -1px rgba(19,25,39,.08),0 2px 4px -2px rgba(19,25,39,.06);
  --sh4:0 10px 15px -3px rgba(19,25,39,.1),0 4px 6px -4px rgba(19,25,39,.06);
  --tap:44px;--barra:64px;
  --font:"Inter",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--f14)/1.45 var(--font);font-feature-settings:"tnum"}
button,select,input{font:inherit;color:inherit}
h1,h2,h3,h4,p{margin:0}
h1,h2,h3,h4,b,strong{font-weight:600}
.ic{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex:none}
.ic.i16{width:16px;height:16px}
.ic.i24{width:24px;height:24px}
.mk{flex:none;display:block}
:focus-visible{outline:3px solid var(--p300);outline-offset:2px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.over{display:block;font-size:var(--f12);font-weight:500;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}

.t-ok{--c:var(--ok);--cb:var(--ok-bg);--ci:var(--ok-ink)}
.t-warn{--c:var(--warn);--cb:var(--warn-bg);--ci:var(--warn-ink)}
.t-crit{--c:var(--crit);--cb:var(--crit-bg);--ci:var(--crit-ink)}
.t-off{--c:var(--off);--cb:var(--off-bg);--ci:var(--off-ink)}
.pill{display:inline-flex;align-items:center;gap:var(--s1);padding:var(--s1) var(--s2);border-radius:var(--r1);background:var(--cb);color:var(--ci);box-shadow:inset 0 0 0 1px var(--c);font-size:var(--f14);font-weight:600;line-height:1.15;white-space:nowrap}
.badge{min-width:20px;height:20px;border-radius:var(--r2);padding:0 var(--s1);font-size:var(--f12);font-weight:600;display:inline-flex;align-items:center;justify-content:center;line-height:1}
.b-crit{background:var(--crit-ink);color:#fff}
.b-warn{background:var(--warn-bg);color:var(--warn-ink);box-shadow:inset 0 0 0 1px var(--warn)}
.b-off{background:var(--off-bg);color:var(--off-ink)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--s2);min-height:40px;padding:0 var(--s4);border-radius:var(--r2);border:1px solid var(--p500);background:#fff;color:var(--p600);font-size:var(--f14);font-weight:600;cursor:pointer;white-space:nowrap}
.btn:hover{background:var(--p50)}
.btn.pri{background:var(--p500);border-color:var(--p500);color:#fff}
.btn.pri:hover{background:var(--p700);border-color:var(--p700)}
.redondo{width:40px;height:40px;padding:0;border-radius:50%;border:0;background:var(--g100);color:var(--g700)}
.redondo:hover{background:var(--g200)}
.redondo[aria-pressed="true"]{background:var(--p500);color:#fff}
.card{background:var(--panel);border-radius:var(--r3);box-shadow:var(--sh1);min-width:0}
.cardHead{display:flex;align-items:center;gap:var(--s3);padding:var(--s4) var(--s4) var(--s2)}
.cardHead>.ic{color:var(--muted)}
.cardHead h2{font-size:var(--f20);line-height:1.4}
.cardHead p{font-size:var(--f12);color:var(--muted)}

/* ---------- avatar de nodo (círculo con número de poste + marca de estado, anillo si requiere atención) ---------- */
.av{position:relative;width:40px;height:40px;border-radius:50%;background:var(--sel);color:var(--ink);font-weight:600;font-size:var(--f14);display:flex;align-items:center;justify-content:center;flex:none}
.av.ring{box-shadow:0 0 0 2px #fff,0 0 0 4px var(--c)}
.av .st{position:absolute;right:-4px;bottom:-4px;background:#fff;border-radius:50%;padding:2px;display:flex}
.av.g{width:56px;height:56px;font-size:var(--f20);box-shadow:0 0 0 4px #fff}
.av.g.ring{box-shadow:0 0 0 4px #fff,0 0 0 7px var(--c)}
.av.g .st{right:0;bottom:0}

/* ---------- barra superior ---------- */
.topbar{position:sticky;top:0;z-index:50;height:var(--barra);background:#fff;box-shadow:var(--sh1);display:flex;align-items:center;gap:var(--s4);padding:0 var(--s5)}
.brand{display:flex;gap:var(--s3);align-items:center;flex:none}
.logo{width:40px;height:40px;flex:none;display:block}
.brand b{display:block;font-size:var(--f16);line-height:1.25}
.brand span{display:block;font-size:var(--f12);color:var(--muted);line-height:1.35}
.estado{display:flex;flex-wrap:wrap;align-items:center;gap:var(--s1) var(--s5);min-width:0}
.estado>span{display:inline-flex;align-items:center;gap:var(--s2);min-width:0}
.estado .viejo{color:var(--warn-ink);font-weight:600}
.topbar .estado{flex:1;justify-content:center;font-size:var(--f14)}
.who{display:flex;align-items:center;gap:var(--s2);flex:none;position:relative;margin-left:auto}
.yo{display:flex;align-items:center;gap:var(--s2);padding:var(--s1) var(--s3) var(--s1) var(--s1);border-radius:999px}
.yo .avatar{width:36px;height:36px;border-radius:50%;background:var(--p500);color:#fff;font-size:var(--f14);font-weight:600;display:flex;align-items:center;justify-content:center;flex:none}
.yo b{display:block;font-size:var(--f14);line-height:1.3}
.yo small{display:block;font-size:var(--f12);color:var(--muted);line-height:1.3}
.herrBtn{display:none}
.menu{position:absolute;right:0;top:calc(100% + var(--s2));z-index:60;background:#fff;border-radius:var(--r2);box-shadow:var(--sh4);padding:var(--s2);display:grid;gap:var(--s1);min-width:240px}
.menu button{display:flex;align-items:center;gap:var(--s3);min-height:var(--tap);border:0;background:none;border-radius:var(--r1);padding:0 var(--s3);cursor:pointer;text-align:left}
.menu button:hover,.menu button.on{background:var(--sel)}

/* ---------- tres columnas ---------- */
.layout{display:grid;grid-template-columns:260px minmax(0,1fr) 360px;gap:var(--s5);padding:var(--s4) var(--s4) var(--s6);max-width:1680px;margin:0 auto;align-items:start}
.izq,.der{position:sticky;top:calc(var(--barra) + var(--s4));max-height:calc(100vh - var(--barra) - var(--s5));overflow-y:auto}
.izq{height:calc(100vh - var(--barra) - var(--s5))}
.izq{display:flex;flex-direction:column;padding:0 0 var(--s2)}
.der{display:grid;gap:var(--s3);padding:2px 2px var(--s2);align-content:start}
.centro{display:grid;gap:var(--s4);min-width:0}
.vista{display:grid;gap:var(--s4);min-width:0}
#estado2{display:flex;justify-content:center;background:none;box-shadow:none;padding:var(--s1) 0 0}

/* accesos (columna izquierda) */
.nav{display:flex;flex-direction:column;gap:var(--s1)}
.nav button{display:flex;align-items:center;gap:var(--s3);width:100%;min-height:52px;border:0;background:none;padding:var(--s1) var(--s2);border-radius:var(--r2);cursor:pointer;font-size:var(--f16);color:var(--ink);text-align:left;position:relative}
.nav button:hover{background:rgba(19,25,39,.06)}
.nav .ci{width:36px;height:36px;border-radius:50%;background:#fff;box-shadow:0 0 0 1px var(--line);display:flex;align-items:center;justify-content:center;flex:none}
.nav button.on{background:var(--g200);color:var(--p700);font-weight:500}
.nav button.on .ci{background:var(--p500);color:#fff;box-shadow:none}
.badges{margin-left:auto;display:flex;gap:var(--s1)}
.divi{height:1px;background:var(--g300);margin:var(--s3) var(--s2)}
.izq>.over{padding:0 var(--s2) var(--s2)}
.brandSide{margin-top:auto;padding:var(--s5) var(--s2) 0}
.brandSide b{font-size:var(--f16)}
.brandTop{display:none}
.pie{margin-top:var(--s5);padding:0 var(--s2);font-size:var(--f12);color:var(--muted)}

/* banner de crítico */
.banner{position:sticky;top:calc(var(--barra) + var(--s2));z-index:30;display:flex;align-items:center;gap:var(--s3);flex-wrap:wrap;background:var(--crit-ink);color:#fff;border-radius:var(--r3);padding:var(--s3) var(--s4);box-shadow:var(--sh4)}
.banner .mkw{background:#EE443F;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;color:#fff;flex:none}
.banner b{display:block;font-size:var(--f16);line-height:1.3}
.banner .acc{margin-left:auto;display:flex;flex-wrap:wrap;gap:var(--s2)}
.banner .btn{border-color:#fff;color:var(--crit-ink)}
.banner .btn.sec{background:transparent;color:#fff}
.banner .btn.sec:hover{background:rgba(255,255,255,.12)}
.tituloVista{padding:var(--s1) var(--s1) 0}
.tituloVista h1{font-size:var(--f24);line-height:1.2}
.tituloVista p{margin-top:var(--s1);color:var(--muted)}

/* ---------- gráficos por poste ---------- */
.graficos{display:grid;grid-template-columns:1fr 1fr;gap:var(--s4);padding:0 var(--s4) var(--s4)}
.graficos h3{font-size:var(--f14);display:flex;align-items:center;gap:var(--s2);margin-bottom:var(--s1)}
.graficos h3 .ic{color:var(--muted)}
.limL{display:flex;flex-wrap:wrap;gap:var(--s1) var(--s3);font-size:var(--f12);color:var(--muted);margin-bottom:var(--s1)}
.limL span{display:inline-flex;align-items:center;gap:var(--s1)}
.limL i{display:inline-block;width:16px;border-top:2px dashed var(--c)}
.graficos svg{width:100%;height:auto;display:block}
.bar{cursor:pointer}
.bar:hover{opacity:.8}
.ax{font-size:12px;fill:var(--muted)}
.lim{stroke:#fff;stroke-width:3px;paint-order:stroke;font-weight:600}

/* ---------- mensaje principal (lo primero que se lee) ---------- */
.hero{background:var(--cb);color:var(--ink);padding:var(--s5);display:grid;grid-template-columns:auto 1fr;gap:var(--s2) var(--s4);align-items:start}
.hero h2{font-size:var(--f24);line-height:1.25}
.hero .sub{font-size:var(--f16);margin-top:var(--s1)}
.hero .otros{font-size:var(--f14);color:var(--muted);margin-top:var(--s2)}
.hero .acc{grid-column:2;display:flex;flex-wrap:wrap;align-items:center;gap:var(--s2);margin-top:var(--s2)}
.hero .cuenta{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:var(--s2);margin-top:var(--s3);padding-top:var(--s3);border-top:1px solid rgba(19,25,39,.12)}
.hero .cuenta span{display:inline-flex;align-items:center;gap:var(--s2);background:rgba(255,255,255,.7);border-radius:var(--r1);padding:var(--s1) var(--s3);font-size:var(--f14)}
/* guía de primera vez */
.guia{padding:var(--s4) var(--s5) var(--s5);display:grid;gap:var(--s3);box-shadow:inset 0 0 0 1px var(--p500),var(--sh2)}
.guiaH{display:flex;align-items:center;gap:var(--s3)}
.guiaH h2{font-size:var(--f20)}
.pasosG{margin:0;padding:0;list-style:none;counter-reset:g;display:grid;gap:var(--s3)}
.pasosG li{counter-increment:g;display:grid;grid-template-columns:32px 1fr;gap:var(--s3);font-size:var(--f16);align-items:start}
.pasosG li:before{content:counter(g);width:32px;height:32px;border-radius:50%;background:var(--info-bg);color:var(--info-ink);font-weight:600;display:flex;align-items:center;justify-content:center}
.colores{display:grid;grid-template-columns:1fr 1fr;gap:var(--s2)}
.colores>span{display:flex;align-items:center;gap:var(--s2);background:var(--soft);border-radius:var(--r2);padding:var(--s2) var(--s3);font-size:var(--f14)}
.guia .btn{justify-self:start}
/* detalles técnicos plegables */
details.tec{border-top:1px solid var(--line);padding-top:var(--s2)}
details.tec>summary{cursor:pointer;font-weight:600;min-height:var(--tap);display:flex;align-items:center;gap:var(--s2);list-style:none;color:var(--info-ink)}
details.tec>summary::-webkit-details-marker{display:none}
details.tec>summary .ic{transition:transform .2s}
details.tec[open]>summary .ic{transform:rotate(90deg)}
details.tec .cont{display:grid;gap:var(--s3);padding-top:var(--s2)}
.explica{font-size:var(--f16);line-height:1.45}
.vars3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s2)}
.vars3.c4{grid-template-columns:repeat(2,minmax(0,1fr))}
.legend b{color:var(--ink);font-weight:600}

/* ---------- vista general ---------- */
.celdas.cuatro{grid-template-columns:repeat(4,minmax(0,1fr))}
.celda .num .mk{display:inline-block;vertical-align:-3px;margin-right:var(--s1)}
.halo{display:none!important;position:absolute;left:50%;bottom:0;width:140px;height:140px;margin:0 0 -70px -70px;border-radius:50%;pointer-events:none;display:none}
.poste.t-crit .halo{display:block;background:radial-gradient(circle,rgba(229,37,44,.6),rgba(229,37,44,0) 70%);animation:pulso 1.8s ease-in-out infinite}
.poste.t-warn .halo{display:block;width:110px;height:110px;margin:0 0 -55px -55px;background:radial-gradient(circle,rgba(240,160,0,.5),rgba(240,160,0,0) 70%)}
@keyframes pulso{50%{transform:scale(1.15);opacity:.7}}
@media (prefers-reduced-motion:reduce){.poste.t-crit .halo{animation:none}}
.poste:not(.lbl) .pin{padding:2px}
.alertaI{display:flex;align-items:center;gap:var(--s3);width:100%;min-height:56px;border:0;background:none;border-radius:var(--r2);padding:var(--s2);cursor:pointer;text-align:left}
.alertaI:hover{background:var(--soft)}
.alertaI.sel{background:var(--g100);box-shadow:inset 3px 0 0 var(--p500)}
.alertaI b{display:block;font-size:var(--f14);line-height:1.3}
.alertaI small{display:block;font-size:var(--f12);color:var(--muted)}
.alertaI .nueva{color:var(--ci);font-weight:600}
.mant{margin:var(--s2) var(--s2) 0;padding-top:var(--s3);border-top:1px solid var(--line);display:grid;gap:var(--s2)}
.mant p{display:flex;align-items:center;gap:var(--s2);font-size:var(--f12);color:var(--muted)}
.dAcc{display:flex;flex-wrap:wrap;align-items:center;gap:var(--s2)}
.dAcc .btn.pri{flex:1}
.donde{font-size:var(--f14);color:var(--muted)}

/* ---------- semáforo de resumen: temperatura, humedad y viento (no se presiona; los nodos se eligen en el mapa) ---------- */
.franjaW{padding:var(--s1) var(--s4) var(--s4)}
.franja{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s2)}
.luz{display:flex;align-items:center;justify-content:space-between;gap:var(--s3);padding:var(--s3) var(--s4);border-radius:var(--r3);min-width:0;min-height:72px}
.luz.t-ok{background:#C5E9CD;color:#256533}
.luz.t-warn{background:#FFBB33;color:#6B4700}
.luz.t-crit{background:#F16965;color:#832523}
.luz.t-off{background:var(--g200);color:var(--g600)}
.luz span{display:block;font-size:var(--f12);font-weight:500}
.luz b{display:block;font-size:28px;line-height:1.15;white-space:nowrap;font-weight:600}
.luz b small{font-size:var(--f14);font-weight:400}
@media(max-width:520px){.luz{flex-direction:column;align-items:flex-start;gap:var(--s1);padding:var(--s2) var(--s3)}.luz b{font-size:var(--f20)}}

/* ---------- KPI ---------- */
.kpiCard{padding:var(--s3) var(--s4) var(--s4)}
.kpiCard>.over{margin-bottom:var(--s2)}
.celdas{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s2)}
.celda{border-radius:var(--r2);padding:var(--s2) var(--s3);background:var(--soft);min-width:0}
.celda.tinte{background:var(--cb);color:var(--ci)}
.celda .lab{display:flex;align-items:center;gap:var(--s1);font-size:var(--f12);color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.celda.tinte .lab{color:var(--ci)}
.celda .lab .ic{color:var(--muted)}
.celda .num{font-size:var(--f24);font-weight:600;line-height:1.3;white-space:nowrap}
.celda .num small{font-size:var(--f14);font-weight:400}

/* ---------- mapa ---------- */
.legend{margin-left:auto;display:flex;flex-wrap:wrap;gap:var(--s1) var(--s4);font-size:var(--f12);color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:var(--s1)}
.map{position:relative;margin:var(--s1) var(--s4) var(--s4);height:420px;border-radius:var(--r2);overflow:hidden;background:#8a7a5a;touch-action:pan-y;user-select:none;-webkit-user-select:none}
.map.zoomed{touch-action:none;cursor:grab}
.mapInner{position:absolute;left:0;top:0;width:100%;height:100%}
.mapInner .sat{position:absolute;left:0;top:0;width:100%;height:100%;display:block;object-fit:cover;pointer-events:none;user-select:none}
.capa{position:absolute;left:0;top:0;width:100%;height:100%}
.poste{position:absolute;width:var(--tap);height:72px;margin:-72px 0 0 -22px;padding:0;border:0;background:none;cursor:pointer;z-index:1}
.poste:focus{outline:none}
.poste:hover,.poste:focus-visible{z-index:4}
.poste.lbl{z-index:2}
.poste.sel{z-index:3}
.poste.izqP .pin{left:auto;right:8px;flex-direction:row-reverse}
.poste.izqP .corto,.poste.izqP .full{padding:0 0 0 var(--s1)}
.palo{position:absolute;left:50%;bottom:0;width:3px;margin-left:-1.5px;height:40px;background:#f4f6f8;border-radius:2px;box-shadow:0 0 0 1px rgba(0,0,0,.28)}
.pin{position:absolute;left:8px;bottom:34px;display:flex;align-items:center;gap:var(--s1);background:#fff;color:var(--ink);border-radius:var(--r2);padding:var(--s1) var(--s1) var(--s1) var(--s1);font-size:var(--f12);font-weight:500;white-space:nowrap;box-shadow:0 1px 4px rgba(0,0,0,.4)}
.pin .corto,.pin .full{padding-right:var(--s1)}
.pin .full{display:none}
.poste.lbl .full,.poste:hover .full,.poste:focus-visible .full{display:block}
.poste.lbl .corto,.poste:hover .corto,.poste:focus-visible .corto{display:none}
.poste.t-warn .pin,.poste.t-crit .pin{box-shadow:0 0 0 2px var(--c),0 2px 6px rgba(0,0,0,.35)}
.poste.sel .pin{box-shadow:0 0 0 3px var(--p500),0 2px 8px rgba(0,0,0,.45)}
.poste:focus-visible .pin{outline:3px solid #fff;outline-offset:3px}
.vec{position:absolute;left:50%;bottom:-12px;width:24px;height:24px;margin-left:-12px;fill:#fff;stroke:#131927;stroke-width:1.2;display:none;filter:drop-shadow(0 1px 1px rgba(0,0,0,.5));transition:transform .6s}
.map.zoomed .vec{display:block}
.zoom{position:absolute;left:var(--s3);bottom:var(--s3);display:flex;flex-direction:column;background:#fff;border-radius:var(--r2);box-shadow:0 2px 8px rgba(0,0,0,.35);overflow:hidden;z-index:5}
.zoom button{width:40px;height:40px;border:0;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center}
.zoom button:hover{background:var(--soft)}
.zoom button:disabled{opacity:.35;cursor:default}
.norte{position:absolute;right:var(--s3);top:var(--s3);width:40px;height:40px;border-radius:50%;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.35);display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:var(--f12);font-weight:600;line-height:1;z-index:5}
.norte svg{width:12px;height:12px;fill:var(--info-ink)}
.vientoMap{position:absolute;right:var(--s3);top:60px;background:#fff;border-radius:var(--r2);box-shadow:0 2px 8px rgba(0,0,0,.35);padding:var(--s1) var(--s2);display:flex;align-items:center;gap:var(--s2);font-size:var(--f12);line-height:1.3;z-index:5}
.vientoMap svg{width:24px;height:24px;fill:var(--info-ink);transition:transform .6s;flex:none}
.escala{position:absolute;right:var(--s4);bottom:var(--s3);color:#fff;font-size:var(--f12);font-weight:600;text-shadow:0 1px 3px #000,0 0 2px #000;z-index:5}
.nums{display:flex;justify-content:space-between;gap:var(--s2);margin-bottom:2px}
.barra{height:6px;border:1.5px solid #fff;border-top:0;position:relative;filter:drop-shadow(0 1px 1px rgba(0,0,0,.7))}
.barra:after{content:"";position:absolute;left:50%;bottom:0;width:1.5px;height:4px;margin-left:-1px;background:#fff}

/* ---------- perfil del nodo (rail derecho) ---------- */
.perfil{overflow:hidden}

.cover{position:relative;height:132px;background:#131927}
.cover .foto{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.cover #camLive{object-fit:contain;background:#131927}
.cover #camCap{top:10px;bottom:auto;left:10px;max-width:calc(100% - 210px);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;z-index:2}
.cover .segMini{z-index:2}
.segMini button:disabled{opacity:.45;cursor:not-allowed}
/* el panel derecho cabe sin scroll: en pantallas bajas se ocultan primero el historial y luego se achica la portada */
.cover>svg{width:100%;height:100%;display:block}
.cover .segMini{position:absolute;top:var(--s2);right:var(--s2);display:flex;background:var(--p500);border-radius:var(--r2);padding:2px}
.segMini button{border:0;background:none;color:#fff;font-size:var(--f12);font-weight:600;min-height:32px;padding:0 var(--s3);border-radius:var(--r1);cursor:pointer}
.segMini button.on{background:#fff;color:var(--p700)}
.cover .cap{position:absolute;left:var(--s2);top:var(--s2);background:rgba(19,25,39,.75);color:#fff;font-size:var(--f12);border-radius:var(--r1);padding:var(--s1) var(--s2)}
.perfHead{display:flex;align-items:flex-end;gap:var(--s3);padding:0 var(--s4);margin-top:-28px;position:relative}
.x{margin-left:auto;border:0;background:var(--soft);border-radius:var(--r2);width:40px;height:40px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex:none}
.x:hover{background:var(--sel)}
.ficha{padding:var(--s2) var(--s4) var(--s3);display:grid;gap:var(--s2)}
.auto{display:flex;gap:var(--s2);align-items:flex-start;font-size:var(--f12);color:var(--info-ink);background:var(--info-bg);border-radius:var(--r1);padding:var(--s2) var(--s3)}
.fichaTop{display:flex;align-items:center;gap:var(--s2);flex-wrap:wrap}
.fichaTop h3{font-size:var(--f20);line-height:1.3}
.meta{font-size:var(--f12);color:var(--muted)}
.vars{display:grid;grid-template-columns:1fr 1fr;gap:var(--s2)}
.var{background:var(--soft);border-radius:var(--r2);padding:var(--s2) var(--s3);min-width:0}
.var.ancho{grid-column:1/-1}
.var>span{display:block;font-size:var(--f12);color:var(--muted)}
.var b{font-size:var(--f20);line-height:1.3}
.var b small{font-size:var(--f12);font-weight:400}
.var em{display:block;font-style:normal;font-size:var(--f12);color:var(--muted)}
.gps{font-size:var(--f14)!important;display:block}
.dirRow{display:flex;align-items:center;gap:var(--s2)}
.flecha{width:32px;height:32px;transition:transform .6s;flex:none}
.r3{display:flex;flex-wrap:wrap;gap:var(--s1);margin-top:var(--s1)}
.rc{display:inline-flex;align-items:center;gap:var(--s1);font-style:normal;font-size:var(--f12);padding:var(--s1) var(--s2);border-radius:var(--r1);background:#fff;color:var(--muted)}
.rc.si{background:var(--crit-bg);color:var(--crit-ink);font-weight:600}
.graf h4{font-size:var(--f14);display:flex;justify-content:space-between;align-items:baseline;gap:var(--s2);margin-bottom:var(--s1)}
.graf h4 span{font-weight:400;color:var(--muted);font-size:var(--f12)}
#gTemp svg,#gHum svg,#gTx svg,#gHm svg{width:100%;height:auto;display:block;touch-action:pan-y}
.nota{font-size:var(--f14);color:var(--muted);padding:var(--s2) 0}
.camNota{font-size:var(--f12);color:var(--muted)}
.hist{list-style:none;margin:0;padding:0;font-size:var(--f14)}
.hist li{display:flex;align-items:center;gap:var(--s2);padding:var(--s2) 0;border-bottom:1px solid var(--line)}
.hist li:last-child{border-bottom:0}
.hist time{color:var(--muted)}
.vacioP{padding:var(--s4);display:grid;gap:var(--s3)}
.vacioP h3{font-size:var(--f20)}
.vacioP>p{color:var(--muted)}
.fila{display:flex;justify-content:space-between;gap:var(--s3);padding:var(--s2) 0;border-bottom:1px solid var(--line);font-size:var(--f14)}
.fila span{color:var(--muted)}
.fila:last-child{border-bottom:0}

/* ---------- lista de nodos (rail derecho, tipo contactos) ---------- */
.nodosC{padding:var(--s3) var(--s2) var(--s2)}
.nodosH{display:flex;align-items:center;gap:var(--s2);padding:0 var(--s2) var(--s2)}
.nodosH h2{font-size:var(--f16)}
.nodosH small{color:var(--muted);font-size:var(--f12)}
.busca{display:flex;align-items:center;gap:var(--s2);margin:0 var(--s2) var(--s2);background:var(--soft);border-radius:999px;padding:0 var(--s3);color:var(--muted)}
.busca input{border:0;background:none;min-height:40px;width:100%;color:var(--ink);outline:none}
.busca:focus-within{outline:3px solid var(--info);outline-offset:1px}
.nodosL{display:grid;gap:2px}
.nodoI{display:flex;align-items:center;gap:var(--s3);width:100%;min-height:56px;border:0;background:none;border-radius:var(--r2);padding:var(--s2);cursor:pointer;text-align:left}
.nodoI:hover{background:var(--soft)}
.nodoI.sel{background:var(--sel)}
.nodoI .inf{min-width:0}
.nodoI .inf b{display:block;font-size:var(--f14);line-height:1.3}
.nodoI .inf b.corto{display:none}
.nodoI .inf small{display:block;font-size:var(--f12);color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nodoI:not(.t-ok) .inf small{color:var(--ci);font-weight:600}
.nodoI .hora{margin-left:auto;font-size:var(--f12);color:var(--muted);flex:none}
.sinRes{padding:var(--s3);color:var(--muted);display:flex;align-items:center;gap:var(--s2)}

/* ---------- feed de alertas (posts) ---------- */
.post{overflow:hidden}
.postH{display:flex;align-items:center;gap:var(--s3);padding:var(--s4) var(--s4) var(--s2)}
.postH b{display:block;font-size:var(--f16);line-height:1.3}
.postH small{display:block;font-size:var(--f12);color:var(--muted)}
.postH .pill{margin-left:auto}
.postB{padding:0 var(--s4) var(--s3);display:grid;gap:var(--s2)}
.postB p{font-size:var(--f16)}
.postB .det{display:flex;align-items:center;gap:var(--s1);font-size:var(--f14);color:var(--muted)}
.etapa{justify-self:start;font-size:var(--f12);font-weight:600;padding:var(--s1) var(--s2);border-radius:var(--r1);background:var(--sel);color:var(--ink)}
.etapa.nueva{background:var(--ink);color:#fff}
.postA{display:flex;border-top:1px solid var(--line);padding:var(--s1)}
.postA button{flex:1;display:flex;align-items:center;justify-content:center;gap:var(--s2);min-height:var(--tap);border:0;background:none;border-radius:var(--r1);font-size:var(--f14);font-weight:600;color:var(--muted);cursor:pointer}
.postA button:hover{background:var(--soft);color:var(--ink)}
.postA button.pri{color:var(--ink)}
.feedH{padding:var(--s4)}
.feedH h2{font-size:var(--f16)}
.feedH p{color:var(--muted);font-size:var(--f14)}
details.pasosC summary{cursor:pointer;padding:var(--s4);font-weight:600;list-style:none;display:flex;align-items:center;gap:var(--s2)}
details.pasosC summary::-webkit-details-marker{display:none}
.pasos{margin:0;padding:0 var(--s4) var(--s4);list-style:none;counter-reset:p;display:grid;gap:var(--s3)}
.pasos li{counter-increment:p;display:grid;grid-template-columns:24px 1fr;gap:var(--s3);font-size:var(--f14);color:var(--muted)}
.pasos li:before{content:counter(p);width:24px;height:24px;font-size:var(--f12);border-radius:50%;background:var(--sel);color:var(--ink);font-weight:600;display:flex;align-items:center;justify-content:center}
.pasos b{display:block;color:var(--ink)}

/* ---------- tablas y otras vistas ---------- */
.tw{overflow-x:auto;padding:0 var(--s2) var(--s3)}
table{width:100%;border-collapse:collapse;font-size:var(--f14)}
th{font-weight:400;color:var(--muted);font-size:var(--f12);text-align:left;padding:var(--s2);background:var(--soft);white-space:nowrap}
th:first-child{border-radius:var(--r1) 0 0 var(--r1)}
th:last-child{border-radius:0 var(--r1) var(--r1) 0}
td{padding:var(--s2);border-bottom:1px solid var(--line);white-space:nowrap;vertical-align:middle}
tr:last-child td{border-bottom:0}
td.nada{color:var(--muted);padding:var(--s4) var(--s2);white-space:normal}
.id2{display:flex;flex-direction:column;line-height:1.3}
.id2 small{font-size:var(--f12);color:var(--muted)}
.par{display:grid;grid-template-columns:1fr 1fr;gap:var(--s4);align-items:start}
.comp{padding:0 var(--s4) var(--s4)}
.metric{display:flex;justify-content:space-between;gap:var(--s3);border-top:1px solid var(--line);padding:var(--s2) 0;font-size:var(--f14)}
.metric:first-child{border-top:0}
.metric b{color:var(--muted);font-weight:400}
.texto{padding:0 var(--s4) var(--s4);font-size:var(--f14);color:var(--muted);max-width:75ch}
.nCtl{display:flex;flex-wrap:wrap;gap:var(--s4);align-items:center;padding:var(--s1) var(--s4) var(--s4)}
.nCtl label{font-size:var(--f14);color:var(--muted);display:flex;align-items:center;gap:var(--s2)}
.nCtl select{font-size:var(--f14);min-height:40px;padding:0 var(--s3);border-radius:var(--r2);border:1px solid var(--g300);background:#fff}
.seg{display:inline-flex;flex-wrap:wrap;border:1px solid var(--g300);border-radius:var(--r2);overflow:hidden}
.seg button{font-size:var(--f14);min-height:40px;padding:0 var(--s4);border:0;background:#fff;color:var(--muted);cursor:pointer}
.seg button.on{background:var(--p50);color:var(--p700);font-weight:600}
.nGrid{display:grid;grid-template-columns:1fr 1fr;gap:var(--s4);align-items:start}
.nBody{padding:0 var(--s4) var(--s4)}
.nTag{display:inline-flex;align-items:center;gap:var(--s2);padding:var(--s1) var(--s3) var(--s1) var(--s1);border-radius:var(--r1);font-size:var(--f14);font-weight:600;background:var(--cb);color:var(--ci);margin-bottom:var(--s2)}
.nFila{display:grid;grid-template-columns:112px 1fr;gap:var(--s2);font-size:var(--f14);padding:var(--s1) 0;border-bottom:1px solid var(--line)}
.nFila span{color:var(--muted)}
.nMapa{display:block;width:100%;max-width:460px;height:auto;border-radius:var(--r2);margin:var(--s2) 0}
.nImgs{display:grid;grid-template-columns:1fr 1fr;gap:var(--s2);margin-top:var(--s1)}
.nImgs figure{margin:0;border-radius:var(--r2);overflow:hidden;background:#131927}
.nImgs svg{display:block;width:100%;height:84px}
.nImgs figcaption{color:#cfd8e5;font-size:var(--f12);text-align:center;padding:var(--s1) 0}
.tel{max-width:340px;margin:0 auto;border:8px solid #131927;border-radius:var(--s5);overflow:hidden;background:#fff}
.telTop{background:#131927;color:#cfd8e5;font-size:var(--f12);text-align:center;padding:var(--s1) 0}
.telMsg{padding:var(--s3) var(--s4) var(--s4);font-size:var(--f14);line-height:1.45}
.telMsg .tit{display:block;font-size:var(--f16);line-height:1.35;margin-bottom:var(--s1)}
.telMsg .over{margin:var(--s3) 0 var(--s1)}
.telMsg .nMapa{margin:var(--s1) 0 var(--s2)}

/* ===== Medidas del diseño de Figma (Dashboard · Monitoreo) ===== */
@media(min-width:1100px){
  .layout{grid-template-columns:240px minmax(0,1fr) 360px;gap:24px;padding:24px 24px 32px;max-width:1440px}
  .izq,.der{top:88px}
}
@media(min-width:1100px){
  .nav{gap:4px;padding-right:0}
  .nav button{min-height:52px;padding:8px 12px 8px 8px;gap:12px;border-radius:8px;font-size:16px;line-height:24px;color:#212936}
  .nav button.on{background:#E5E7EA;color:#3745AF;font-weight:500}
  .nav .ci{width:36px;height:36px;box-shadow:none;border:1px solid #E5E7EA;background:#fff}
  .nav button.on .ci{border:0;background:#0095FF}
  .nav .ci .ic{width:20px;height:20px}
  .divi{margin:12px 8px;background:#D2D5DB}
  .izq>.over{padding:0 0 4px 8px;letter-spacing:.04em}
  .brandSide{padding:24px 0 0 5px}
  .brandSide b{font-size:16px;line-height:24px;font-weight:600}
  .brandSide span{font-size:12px;line-height:16px;color:#4D5461}
}
.badge{height:20px;min-width:20px;border-radius:10px;padding:0 6px;font-weight:500}
.b-crit{background:#D93E39}
.topbar{padding:0 24px}
.yo{gap:10px;padding:0 0 0 8px}
.yo .avatar{width:36px;height:36px;font-size:12px;font-weight:500}
.yo b{font-size:14px;line-height:20px;font-weight:500}
.yo small{font-size:12px;line-height:16px}
.centro,.vista{gap:16px}
#estado2{min-height:20px;padding:0;gap:8px}
#estado2 .eSis{gap:8px;font-size:14px;line-height:20px}
#estado2 b{font-weight:500}
.banner{padding:12px 16px;gap:12px;border-radius:12px;min-height:64px;box-shadow:0 2px 4px -2px rgba(19,25,39,.06),0 4px 6px -1px rgba(19,25,39,.08)}
.banner .mkw{width:24px;height:24px;background:#EE443F}
.banner .mkw .ic{width:16px;height:16px;stroke-width:1.5}
.banner b{font-size:16px;line-height:24px;font-weight:600}
.banner span{font-size:12px;line-height:16px;color:#FDECEC}
.banner .acc{gap:12px}
.banner .btn{min-height:40px;padding:0 16px;border-radius:8px;gap:8px;font-size:14px;line-height:16px}
.banner .btn .ic{width:16px;height:16px}
/* tarjetas de contenido: 16 20 20 */
#grafCard,#mapCard{padding:16px 20px 20px;display:grid;gap:12px}
#grafCard{gap:16px}
#grafCard .cardHead,#mapCard .cardHead{padding:0;gap:10px;min-height:28px}
.cardHead h2{font-size:18px;line-height:28px;font-weight:600}
#mapCard .cardHead>.ic{width:20px;height:20px;color:#4D5461}
.franjaW{padding:0}
.franja{gap:8px}
.luz{padding:14px 16px;border-radius:15px;min-height:72px}
.luz span{font-size:12px;line-height:16px;font-weight:500}
.luz b{font-size:28px;line-height:34px;font-weight:600}
.luz b small{font-size:14px;line-height:20px;font-weight:400;margin-left:4px}
.luz .punto{width:20px;height:20px;border-radius:50%;flex:none}
.luz.t-crit .punto{background:#A9302D}
.luz.t-warn .punto{background:#B57900}
.luz.t-ok .punto{background:#308242}
.luz.t-off .punto{background:#6D717F}
.legend{gap:16px}
.legend span{gap:6px;font-size:12px;line-height:16px;color:#4D5461}
.map{margin:0;height:420px;border-radius:8px}
.zoom{left:12px;bottom:12px;border-radius:8px;box-shadow:0 2px 4px -2px rgba(19,25,39,.06),0 4px 6px -1px rgba(19,25,39,.08)}
.zoom button .ic{width:20px;height:20px}
.norte{right:12px;top:12px;box-shadow:0 2px 4px -2px rgba(19,25,39,.06),0 4px 6px -1px rgba(19,25,39,.08)}
.vientoMap{right:12px;top:60px;padding:6px 12px 6px 8px;gap:8px;border-radius:8px;box-shadow:0 2px 4px -2px rgba(19,25,39,.06),0 4px 6px -1px rgba(19,25,39,.08)}
/* panel derecho */
.der{gap:16px;padding:0}
.nodosC{padding:16px 12px;display:grid;gap:8px}
.nodosH{padding:0 8px 4px;gap:8px}
.nodosH h2{font-size:18px;line-height:28px;font-weight:600}
.nodosH small{background:#F3F4F6;border-radius:10px;padding:2px 8px;font-size:12px;line-height:16px;font-weight:500;color:#394050}
.nodosL{gap:0}
.alertaI{min-height:60px;padding:10px 12px;gap:12px;border-radius:8px}
.alertaI.sel{background:#F3F4F6;box-shadow:none}
.alertaI .txt{flex:1;min-width:0;display:grid;gap:2px}
.alertaI b{font-size:16px;line-height:24px;font-weight:600}
.alertaI small{font-size:12px;line-height:16px;color:#4D5461}
.alertaI .sit{font-size:12px;line-height:16px;font-weight:500;color:#4D5461;flex:none}
.alertaI .sit.nueva{color:#A9302D}
.mant{margin:0;padding:12px 8px 0;gap:8px;border-top:1px solid #E5E7EA}
.mant p{gap:8px;font-size:12px;line-height:16px}
.cover{height:132px}
.cover .segMini{top:10px;right:10px;background:#006AB5;border-radius:8px;padding:2px;gap:2px}
.segMini button{min-height:28px;padding:6px 12px;border-radius:6px;font-size:12px;line-height:16px;font-weight:600}
.segMini button.on{color:#006AB5}
.perfHead{padding:0 20px;gap:12px;margin-top:-36px}
.av.g{width:64px;height:64px;font-size:24px}
.ficha{padding:12px 20px 20px;gap:12px}
.fichaTop{gap:8px}
.fichaTop h3{font-size:18px;line-height:28px;font-weight:600}
.pill{padding:4px 8px 4px 4px;gap:4px;border-radius:6px;font-size:14px;line-height:20px;font-weight:500}
.donde{font-size:14px;line-height:20px;color:#4D5461}
.dAcc .btn{min-height:40px;padding:0 16px;gap:8px;border-radius:8px;font-size:14px;line-height:16px}
.dAcc .btn .ic{width:16px;height:16px}
.explica{font-size:14px;line-height:20px;color:#212936}
.vars3{gap:8px}
.vars3 .var{padding:8px 12px;border-radius:8px;background:#F9FAFB;border:1px solid #E5E7EA;display:grid;gap:2px}
.vars3 .var>span{font-size:12px;line-height:16px;color:#4D5461}
.vars3 .var b{font-size:18px;line-height:28px;font-weight:600}
.vars3 .var b small{font-size:12px;line-height:16px;color:#4D5461;margin-left:4px}
.histB{padding-top:4px}
.histB h4{font-size:16px;line-height:24px;font-weight:600;margin-bottom:8px}
.hist{display:grid;gap:8px}
.hist li{padding:0;border:0;gap:8px;font-size:14px;line-height:20px}
details.tec{border:0;padding-top:4px}
details.tec>summary{min-height:24px;gap:4px;font-size:14px;line-height:20px;font-weight:500;color:#006AB5}
details.tec>summary .ic{width:16px;height:16px;order:2}

/* ===== Componentes de Figma (página Componentes) ===== */
/* Chip estado: 30 alto, 4 8 4 4, gap 4, radio 6, borde 1 */
.pill{min-height:30px;box-sizing:border-box;padding:4px 8px 4px 4px;gap:4px;border-radius:6px;font-size:14px;line-height:20px;font-weight:500}
.pill.t-ok{background:#ECF8EF;box-shadow:inset 0 0 0 1px #308242;color:#256533}
.pill.t-warn{background:#FFF7E6;box-shadow:inset 0 0 0 1px #FFAA00;color:#8C5E00}
.pill.t-crit{background:#FDECEC;box-shadow:inset 0 0 0 1px #D93E39;color:#A9302D}
.pill.t-off{background:#F3F4F6;box-shadow:inset 0 0 0 1px #6D717F;color:#4D5461}
/* Button: 40 alto, 0 16, gap 8, radio 8, ícono 16 */
.btn{min-height:40px;padding:0 16px;gap:8px;border-radius:8px;font-size:14px;line-height:16px;font-weight:600;border-color:#0095FF;color:#0095FF}
.btn.pri{background:#0095FF;border-color:#0095FF;color:#fff}
.btn .ic{width:16px;height:16px}
/* Avatar nodo: 40, fondo gris 100, borde 2 del color del estado, halo 20 con marca 16 */
.av{--mkc:#EE443F;width:40px;height:40px;box-sizing:border-box;background:#F3F4F6;color:#131927;font-size:16px;line-height:24px;font-weight:600;box-shadow:none}
.av.t-warn{border:2px solid #FFAA00}
.av.t-crit{border:2px solid #D93E39}
.av .st{width:20px;height:20px;box-sizing:border-box;right:-4px;bottom:-4px;padding:0;align-items:center;justify-content:center;background:#fff}
.av.t-warn .st{background:#FFAA00;border:2px solid #fff}
.av.t-warn .st .mk{width:14px;height:14px}
.av.g{width:64px;height:64px;font-size:24px;box-shadow:0 0 0 4px #fff}
.av.g.t-warn,.av.g.t-crit{border-width:3px}
.av.g .st{width:30px;height:30px;right:-2px;bottom:-2px}
.av.g.t-warn .st .mk{width:20px;height:20px}
.alertaI .av{background:#F9FAFB}
/* Pin mapa: etiqueta 6 10 6 6, gap 6, radio 8, Shadow/400; borde 2 en advertencia y crítico; poste 3x36 */
.pin{--mkc:#EE443F;box-sizing:border-box;bottom:32px;padding:6px 10px 6px 6px;gap:6px;border-radius:8px;font-size:12px;line-height:16px;font-weight:500;color:#131927;box-shadow:0 2px 4px -2px rgba(19,25,39,.06),0 4px 6px -1px rgba(19,25,39,.08)}
.pin .corto,.pin .full,.poste.izqP .corto,.poste.izqP .full{padding:0}
.poste.t-warn .pin{border:2px solid #B57900;box-shadow:0 2px 4px -2px rgba(19,25,39,.06),0 4px 6px -1px rgba(19,25,39,.08)}
.poste.t-crit .pin{border:2px solid #D93E39;box-shadow:0 2px 4px -2px rgba(19,25,39,.06),0 4px 6px -1px rgba(19,25,39,.08)}
.poste.sel .pin{box-shadow:0 0 0 3px #0095FF,0 4px 6px -1px rgba(19,25,39,.25)}
.palo{width:3px;height:36px;background:#fff;border-radius:2px;box-shadow:0 1px 2px rgba(19,25,39,.06),0 1px 3px rgba(19,25,39,.08),0 0 0 1px rgba(0,0,0,.18)}
.banner .mkw{--mkc:#EE443F}


/* ===== Bienvenida (modal) y Ayuda ===== */
.modal{position:fixed;inset:0;z-index:200;background:rgba(19,25,39,.48);display:flex;align-items:center;justify-content:center;padding:16px}
.modal[hidden]{display:none}
body.conModal{overflow:hidden}
.modal .guia{width:min(560px,100%);max-height:calc(100vh - 32px);overflow:auto;padding:24px;gap:16px;border-radius:16px;box-shadow:0 12px 16px -4px rgba(19,25,39,.08),0 4px 6px -2px rgba(19,25,39,.03)}
.guiaH h2{font-size:18px;line-height:28px;font-weight:600;flex:1}
.guiaIc{width:36px;height:36px;border-radius:18px;background:#E6F4FF;color:#006AB5;display:flex;align-items:center;justify-content:center;flex:none}
.guiaIc .ic{width:20px;height:20px}
.pasosG li{font-size:14px;line-height:20px}
.pasosG li:before{width:28px;height:28px;background:#E6F4FF;color:#006AB5;font-size:14px}
.pasosG{gap:12px}.pasosG li{grid-template-columns:28px 1fr;align-items:center}
.colores{gap:8px}.colores>span{background:#F9FAFB;border:1px solid #E5E7EA;border-radius:8px;padding:8px 12px;font-size:13px;line-height:18px;align-items:flex-start}
.colores .mk{flex:none;margin-top:-1px}
.guiaAcc{display:flex;flex-wrap:wrap;gap:8px}
.guiaPie{font-size:12px;line-height:16px;color:#4D5461}
.guiaInicio,.irAyuda{display:flex;align-items:center;gap:12px;width:100%;border:0;text-align:left;cursor:pointer;padding:16px 20px;font:inherit;color:#131927}
.guiaInicio:hover,.irAyuda:hover{background:#F9FAFB}
.guiaInicio>span:nth-child(2){flex:1}
.guiaInicio b{display:block;font-size:16px;line-height:24px;font-weight:600}
.guiaInicio small{display:block;font-size:12px;line-height:16px;color:#4D5461}
.irAyuda span{flex:1;font-weight:600;font-size:14px;line-height:20px}
.irAyuda>.ic:first-child{color:#006AB5;width:20px;height:20px}
.guiaInicio>.ic,.irAyuda>.ic:last-child{width:16px;height:16px;color:#6D717F}
details.guiaA>summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:12px;padding:16px 20px}
details.guiaA>summary::-webkit-details-marker{display:none}
details.guiaA>summary>span:nth-child(2){flex:1}
details.guiaA>summary b{display:block;font-size:16px;line-height:24px;font-weight:600}
details.guiaA>summary small{display:block;font-size:12px;line-height:16px;color:#4D5461}
details.guiaA>summary .n{width:32px;height:32px;border-radius:16px;background:#F3F4F6;color:#394050;font-weight:600;font-size:14px;display:flex;align-items:center;justify-content:center;flex:none}
details.guiaA[open]>summary .n{background:#0095FF;color:#fff}
details.guiaA>summary>.ic{width:16px;height:16px;color:#6D717F;transition:transform .2s}
details.guiaA[open]>summary>.ic{transform:rotate(90deg)}
details.guiaA .pasos{padding:0 20px 20px 64px;gap:12px}
details.guiaA .pasos li{font-size:14px;line-height:20px;color:#4D5461}
details.guiaA .cuerpo{padding:0 20px 20px 64px;display:grid;gap:12px;font-size:14px;line-height:20px;color:#4D5461}
.umbrales{display:grid;gap:6px}
.umbrales span{display:flex;align-items:center;gap:8px;font-size:13px;line-height:18px;color:#212936}
.umbrales i{width:12px;height:12px;border-radius:50%;flex:none}
.umbrales .t-ok i{background:#308242}.umbrales .t-warn i{background:#B57900}.umbrales .t-crit i{background:#A9302D}
@media(max-width:640px){details.guiaA .pasos,details.guiaA .cuerpo{padding-left:20px}.colores{grid-template-columns:1fr}}


/* ===== Ajuste a la pantalla (escritorio): todo el diseño de Figma (1440 × 975) se escala para caber sin scroll ===== */
html.ajuste .layout{max-width:none}
html.ajuste .izq,html.ajuste .der{max-height:calc(var(--alto) - var(--barra) - 48px)}
html.ajuste .izq{height:calc(var(--alto) - var(--barra) - 48px)}
html.ajuste .der{overflow-y:auto;overscroll-behavior:contain}
html.ajuste body:not(.noMon) .layout{height:calc(var(--alto) - var(--barra));align-items:stretch;overflow:hidden}
html.ajuste body:not(.noMon) .centro{display:flex;flex-direction:column;min-height:0}
html.ajuste body:not(.noMon) #v-monitoreo{display:flex;flex-direction:column;flex:1 1 auto;min-height:0}
html.ajuste body:not(.noMon) #mapCard{display:flex;flex-direction:column;flex:1 1 auto;min-height:0}
html.ajuste body:not(.noMon) .map{flex:1 1 auto;height:auto;min-height:220px}
html.ajuste body.noMon .der{overflow-y:auto}
html.apretado .histB{display:none}

/* ---------- adaptable ---------- */
/* columna izquierda solo con íconos */
@media(max-width:1099px){
  .layout{grid-template-columns:72px minmax(0,1fr) 340px}
  .izq .lbl,.izq>.over,.izq .pie,.izq .badges{display:none}
  .izq .brandSide{display:none}
  .izq{height:auto}
  .nav button{justify-content:center;padding:var(--s2) 0}
  .nav .ci{position:relative}
  .nav .ci .dotB{display:block}
}
.dotB{display:none;position:absolute;top:-4px;right:-6px;min-width:20px;height:20px;border-radius:10px;background:var(--crit-ink);color:#fff;font-size:var(--f12);font-weight:600;line-height:20px;text-align:center;padding:0 var(--s1)}
.dotB.w{background:var(--warn-bg);color:var(--warn-ink);box-shadow:inset 0 0 0 1px var(--warn)}
/* el rail derecho pasa debajo del feed: orden pensado para una pantalla angosta */
@media(max-width:1099px){
  .layout{grid-template-columns:72px minmax(0,1fr)}
  .izq{grid-column:1;grid-row:1/span 40}
  .centro,.der,#v-monitoreo{display:contents}
  .der{position:static;max-height:none;overflow:visible}
  #estado2{order:0}#banner{order:1}.tituloVista{order:2}#guia{order:3}#grafCard{order:4}#alertasC{order:6}#mapCard{order:7}#detalle{order:8}
  .vista:not(#v-monitoreo){order:8}
  .noMon #alertasC,.noMon #detalle{display:none}
  .nodosL{display:flex;overflow-x:auto;gap:var(--s2);padding-bottom:var(--s1)}
  .nodoI{flex-direction:column;width:auto;min-width:76px;gap:var(--s2);text-align:center;padding:var(--s2) var(--s1)}
  .nodoI .av{width:52px;height:52px;font-size:var(--f16)}
  .nodoI .inf b.full,.nodoI .inf small,.nodoI .hora{display:none}
  .nodoI .inf b.corto{display:block;font-size:var(--f12)}
  .busca{display:none}
  #alertasL{display:grid;overflow:visible}
}
/* barra inferior fija con las 3 vistas operativas */
@media(max-width:819px){
  .layout{display:flex;flex-direction:column;align-items:stretch;padding:var(--s3) var(--s3) 96px}
  .layout>*,.centro>*,.der>*,#v-monitoreo>*{min-width:0;max-width:100%}
  .celda .lab{white-space:normal;flex-wrap:wrap}
  .izq{position:fixed;left:0;right:0;bottom:0;top:auto;max-height:none;height:auto;z-index:40;background:#fff;border-top:1px solid var(--line);box-shadow:0 -2px 8px rgba(19,25,39,.06);padding:var(--s1) var(--s2)}
  .izq .divi,#navHerr{display:none}
  .nav{flex-direction:row}
  .nav button{flex:1;flex-direction:column;gap:2px;min-height:56px;font-size:var(--f12);padding:var(--s1)}
  .izq .lbl{display:block}
  .nav .ci{width:32px;height:32px}
  .herrBtn{display:inline-flex}
  .brandTop{display:flex}
  .brandSide{display:none}
  .brand span,.yo .txt{display:none}
  .yo{padding:0}
  .topbar{gap:var(--s2);padding:0 var(--s3)}
  .graficos,.par,.nGrid{grid-template-columns:minmax(0,1fr)}
  .map{height:300px}
  .cardHead{flex-wrap:wrap}
  .legend{margin-left:0;width:100%}
  .hero{padding:var(--s4);grid-template-columns:auto 1fr}
  .hero h2{font-size:var(--f20)}
  .hero .acc{grid-column:1/-1}
  .colores{grid-template-columns:1fr}
  .banner{top:calc(var(--barra) + var(--s1))}
}
@media(max-width:520px){
  .celdas.cuatro{grid-template-columns:1fr 1fr}
  .brand>div{display:none}
  .celda .num{font-size:var(--f20)}
  .banner .acc{margin-left:0;width:100%}
  .nFila{grid-template-columns:1fr}
  .postA button{font-size:var(--f12)}
}
@media(pointer:coarse){
  .zoom button,.x{width:44px;height:44px}
  .btn,.seg button,.nCtl select,.segMini button{min-height:44px}
}
</style>
