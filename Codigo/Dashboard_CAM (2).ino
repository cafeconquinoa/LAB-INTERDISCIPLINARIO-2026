  sondear($("gHum"),$("lHum"),function(){var s=selActual();return s?s.hh:[];},"%",0,0,100);
  arrastre();
  var espera=null;
  window.addEventListener("resize",function(){clearTimeout(espera);espera=setTimeout(function(){ajustar();if(vista==="monitoreo"){encuadrar(true);}},120);});
